# ---------------------------------------------------------------------------
# CP Tutor Agent — copy to `.env` and fill in. `.env` is gitignored.
# ---------------------------------------------------------------------------

# --- Who are we coaching? --------------------------------------------------
CODEFORCES_HANDLE=your_cf_handle
LEETCODE_USERNAME=your_lc_username

# Optional. LeetCode's *public* GraphQL API only exposes your ~20 most recent
# accepted submissions. Paste your LEETCODE_SESSION cookie here to unlock the
# full solved list via the authenticated `problemsetQuestionList` query.
# (DevTools -> Application -> Cookies -> leetcode.com -> LEETCODE_SESSION)
LEETCODE_SESSION=

# --- LLM -------------------------------------------------------------------
# Without a key the app still runs: the router falls back to a deterministic
# keyword classifier and template-based answers. Handy for CI and offline demos.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-4-6
LLM_TEMPERATURE=0.2

# --- Vector store ----------------------------------------------------------
# persistent = embedded Chroma writing to disk (default, no extra service)
# http       = talk to the `chroma` container from docker-compose
CHROMA_MODE=persistent
CHROMA_PERSIST_DIR=./data/chroma
CHROMA_HOST=chroma
CHROMA_PORT=8000
CHROMA_COLLECTION=solved_problems

# sentence-transformers = local MiniLM (free, offline, ~90MB model)
# chroma-default        = Chroma's bundled ONNX MiniLM (smaller install)
EMBEDDING_BACKEND=sentence-transformers
EMBEDDING_MODEL=all-MiniLM-L6-v2

# --- Cache -----------------------------------------------------------------
CACHE_BACKEND=sqlite
CACHE_DB_PATH=./data/cache.db
CACHE_TTL_SECONDS=3600
PROBLEMSET_CACHE_TTL_SECONDS=86400

# --- HTTP resilience -------------------------------------------------------
HTTP_TIMEOUT_SECONDS=20
HTTP_MAX_RETRIES=4
HTTP_BACKOFF_BASE_SECONDS=0.5

# --- Scheduled sync --------------------------------------------------------
SYNC_ENABLED=true
SYNC_INTERVAL_MINUTES=360
SYNC_ON_STARTUP=false

# --- Logging ---------------------------------------------------------------
LOG_LEVEL=INFO
LOG_JSON=false
